# Safe example values only. Never commit real credentials.
CYBERBRAIN_MCP_AUTH_TOKEN=replace-with-a-long-random-token
CYBERBRAIN_QDRANT_API_KEY=

# Optional Dream Reasoner connection.
CYBERBRAIN_DREAM_REASONER_URL=
CYBERBRAIN_DREAM_REASONER_TOOL=reason_task
CYBERBRAIN_DREAM_REASONER_BEARER_TOKEN=
CYBERBRAIN_DREAM_REASONER_API_KEY=

# Optional local Reasoner profile.
REASONER_AUTH_TOKEN=replace-with-a-separate-long-random-token
REASONER_REQUIRE_AUTH=true
REASONER_BACKEND=ollama
REASONER_OLLAMA_URL=http://embedding:11434
REASONER_OLLAMA_MODEL=
REASONER_OLLAMA_TIMEOUT_SECONDS=120
REASONER_OLLAMA_NUM_PREDICT=700

# Knowledge retrieval: vector (default), literal (fingerprint route), hybrid (RRF).
# Foreground lexical modes are opt-in; benchmark before production promotion.
CYBERBRAIN_KNOWLEDGE_RETRIEVAL_MODE=vector
CYBERBRAIN_KNOWLEDGE_RETRIEVAL_MAX_RECORDS=10000
CYBERBRAIN_KNOWLEDGE_RETRIEVAL_CANDIDATE_MULTIPLIER=3
